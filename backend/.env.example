# Local development only. Compose binds the API and database to loopback.
POSTGRES_USER=dragons
POSTGRES_PASSWORD=dragons_local_only
POSTGRES_DB=dragons_market
# Logins the Compose services use, created from ops/roles.sql. Change all three outside local development.
API_DB_PASSWORD=dragons_api_local_only
INDEXER_DB_PASSWORD=dragons_indexer_local_only
WORKER_DB_PASSWORD=dragons_worker_local_only
PUBLISHER_DB_PASSWORD=dragons_publisher_local_only
AGENT_DB_PASSWORD=dragons_agent_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://dragons:dragons_local_only@127.0.0.1:55432/dragons_market
HOST=127.0.0.1
PORT=3500
NETWORK=mainnet
# Set the complete deployment together once contract IDs are agreed.
# Deployment IDs distinguish fresh deployments on the same network/accounts.
DEPLOYMENT_ID=
DEPLOYMENT_START_BLOCK=
MARKET_CONTRACT_ID=
ROUNDS_CONTRACT_ID=
ORACLE_CONTRACT_ID=
COUNCIL_CONTRACT_ID=
VERIFIER_CONTRACT_ID=
COLLATERAL_TOKEN_ID=
COLLATERAL_DECIMALS=6
# Empty RPC URLs select defaults by NETWORK; no key is needed for public RPCs.
# sandbox: http://127.0.0.1:3030 (set a reachable URL when using Docker)
# testnet: https://test.rpc.fastnear.com
# mainnet: https://free.rpc.fastnear.com, or https://rpc.mnesislabs.com with RPC_PRIMARY_BEARER_TOKEN
RPC_URL=
# Archive defaults: archival-rpc.testnet.near.org / archival-rpc.mainnet.near.org
# Used explicitly for recovery/diagnostics, never as an automatic high-volume fallback.
RPC_ARCHIVAL_URL=
# Optional future paid primary credential; never sent to the archive or public API.
RPC_PRIMARY_BEARER_TOKEN=
# A second provider, run by someone else. Both must agree a wallet key is a full access key before a sign-in or an agent
# access token counts. Required on mainnet: without it nobody can sign in. Its token goes to this URL only.
RPC_SECOND_URL=
RPC_SECOND_BEARER_TOKEN=
RPC_TIMEOUT_MS=10000
RPC_INTERVAL_MS=1000
WEB_ORIGIN=http://localhost:3400
# Number of reverse proxies in front of the API (Caddy, nginx). 0 means none: X-Forwarded-For is ignored and
# every request is limited by its socket address. Set it to 1 behind one proxy, or every user shares one limit.
TRUSTED_PROXY_HOPS=0
# Enables GET /v1/operator/services (Bearer token, 32+ characters). Unset leaves the route answering 404.
OPERATOR_TOKEN=
# Wallet session limits in seconds: 7 days absolute, 12 hours idle.
SESSION_ABSOLUTE_SECONDS=604800
SESSION_IDLE_SECONDS=43200
# Addresses (or CIDR ranges, comma separated) the proxy connects from. X-Forwarded-For is trusted only from these.
TRUSTED_PROXY_ADDRESSES=

# Not deployed: keep the deployment fields above empty until the contract team supplies the manifest.
# Optional CoinGecko demo credential, header-only and never returned by the API.
COINGECKO_DEMO_API_KEY=
# SHA-256 of the actual published policies. Acknowledgements stay disabled until both are set.
POLICY_TERMS_HASH=
POLICY_PRIVACY_HASH=
# Host feed export must remain under backend/.local/feeds.
KEEPER_FEED_PATH=.local/feeds/keeper.jsonl

# Agent accounts run in the agent worker (docker compose --profile agents). The API only reaches it, so set both of these
# or neither: the URL is http://agent-worker:3510 under Compose, and the token is at least 32 random characters.
AGENT_WORKER_URL=
AGENT_WORKER_TOKEN=
# The worker's own secrets never go in this file, and the API refuses to start if it sees them. Put these in
# .env.agent-worker, which only the worker reads. The grant key is 32 random bytes in base64 that seal grant tokens at rest.
# AGENT_API_URL=
# AGENT_API_KEY=
# AGENT_GRANT_KEY=
# AGENT_API_WALLET_CONTRACT=
# Public account that receives sponsored policy storage refunds; blank means no sponsor.
# AGENT_API_POLICY_SPONSOR=

# CoinMarketCap: keyed, keyless, or off. One batch per collection cycle.
COINMARKETCAP_MODE=keyless
# Server-side credential, header-only. Never put this in NEXT_PUBLIC variables.
COINMARKETCAP_API_KEY=

# Round price publishing (docker compose --profile publishing). Signing stays off until the owner approves the source rules:
# PUBLISH_ROUND_PRICES must be the word "approved", and the largest spread between exchanges has no default. Every
# exchange must answer, so that every publisher signs the same median. The key file holds one NEAR
# secret key (ed25519:...) listed as a publisher on the rounds contract; keep it chmod 600 at backend/.local/publisher.key.
PUBLISH_ROUND_PRICES=
PRICE_MAX_DEVIATION_BPS=

# Intents relay for EVM and Solana wallets (POST /intents/relay, GET /intents/fee). Off unless the first three are set.
# RELAYER_KEY is the secret half of a FunctionCall key on RELAYER_ACCOUNT_ID limited to the verifier's execute_intents;
# full-access and unlimited keys are refused. Mainnet permits at most 5 NEAR allowance.
# Every instance must use the same Postgres journal and key scope, including during rolling deployments.
# The fee is priced live from the gas price and the NEAR/USD median, plus RELAY_SWAP_COST_BPS for converting the collected
# collateral back into NEAR, never below RELAY_MIN_FEE (collateral units; USDC has 6 decimals). While it would be above
# RELAY_MAX_FEE the relay refuses every action with fee_unavailable rather than relay at a loss. The website refuses
# any fee above its own MAX_RELAY_FEE in web/lib/relay.ts, so raising RELAY_MAX_FEE also needs that constant raised.
RELAYER_ACCOUNT_ID=
RELAYER_KEY=
RELAYER_PUBLIC_KEY=
RELAY_MIN_FEE=
RELAY_MAX_FEE=100000
RELAY_SWAP_COST_BPS=150
# The relay key spends its own allowance, which nothing refills. Below this many NEAR the API logs relay_key_allowance_low and
# flags it on /health/ready. See docs/OPERATIONS.md, "Intents relay".
RELAY_KEY_ALLOWANCE_ALERT_NEAR=1

# Relay gas top-up (npm run relay:topup, on a schedule; never inside the API). When the relayer's spendable NEAR (balance
# minus storage) is below RELAY_TOPUP_BELOW_NEAR and its Intents collateral balance holds at least RELAY_TOPUP_MIN_USDC,
# it swaps up to RELAY_TOPUP_MAX_USDC of collected fees into wNEAR through 1Click and withdraws that as native NEAR to
# RELAYER_ACCOUNT_ID. Amounts are collateral units (USDC has 6 decimals: 20000000 is 20 USDC). A quote is refused when the
# price it guarantees is worse than the exchange NEAR/USD median by more than RELAY_TOPUP_MAX_SLIPPAGE_BPS; 1Click adds
# 25 bps without a partner key, and that comes out of this budget. Mainnet only. See docs/OPERATIONS.md, "Relay gas top-up".
# RELAY_TOPUP_MODE is dry-run (quotes and logs, signs nothing) unless set to execute.
RELAY_TOPUP_MODE=dry-run
RELAY_TOPUP_BELOW_NEAR=
RELAY_TOPUP_MIN_USDC=
RELAY_TOPUP_MAX_USDC=
# The most collateral all runs together may deposit in any 24 hours, counted in the shared Postgres journal. At least
# RELAY_TOPUP_MAX_USDC.
RELAY_TOPUP_MAX_USDC_PER_DAY=
RELAY_TOPUP_MAX_SLIPPAGE_BPS=200
# RELAY_TREASURY_KEY is an ed25519 secret key registered in intents.near for RELAYER_ACCOUNT_ID with add_public_key.
# It can move everything in the relayer's Intents account, so it lives only in backend/.env.relay-topup, never in .env:
# the API refuses to start when it sees it. Needed only in execute mode, like RELAY_TOPUP_SUBMIT_KEY.
RELAY_TREASURY_KEY=
# RELAY_TOPUP_SUBMIT_KEY is the secret half of a second FunctionCall key on RELAYER_ACCOUNT_ID, limited to the verifier's
# execute_intents like RELAYER_KEY. The job sends its transactions with it, so RELAYER_KEY's nonce never moves under a
# top-up and the API relay never refuses a user with relay_key_shared. It also belongs only in .env.relay-topup. The three
# keys (RELAYER_KEY, RELAY_TREASURY_KEY, RELAY_TOPUP_SUBMIT_KEY) must all differ. Give the key an allowance of 1 NEAR: the
# job refuses one with no allowance or more than 5 NEAR. The job reads RELAYER_PUBLIC_KEY for separation checks and
# refuses RELAYER_KEY. It uses DATABASE_URL for its lock and journal (relay_topup_journal and relay_topup_deposits). Set
# DATABASE_URL in .env.relay-topup to a login in the dm_relay_topup role (ops/roles.sql), not the API's.
RELAY_TOPUP_SUBMIT_KEY=
RELAY_TREASURY_PUBLIC_KEY=
RELAY_TOPUP_SUBMIT_PUBLIC_KEY=
