{
  "$description": "Dragons Market design tokens: the only place raw design values live. npm run tokens generates app/tokens.generated.css and the front matter of DESIGN.md, and fails on contrast.",
  "brand": {
    "orchid": {
      "value": "#d4a2db",
      "description": "Primary brand colour. Orchid on dark grounds."
    },
    "orchid-deep": {
      "value": "#6e0183",
      "description": "Orchid for light grounds and print."
    },
    "mint": {
      "value": "#a8dfc0",
      "description": "Second brand colour. The crest, social and campaign highlights."
    },
    "mint-deep": {
      "value": "#23734d",
      "description": "Mint for light grounds and print."
    },
    "night": {
      "value": "#0b080e",
      "description": "Purple-black ground for dark media."
    },
    "bone": {
      "value": "#f0edf2",
      "description": "Off-white for type on night."
    }
  },
  "partner": {
    "spark": {
      "value": "#ff8a3d",
      "description": "Arena partner: rocket spark and climb glow."
    },
    "flare": {
      "value": "#ff3d6e",
      "description": "Arena partner: smoke, crash line, ball."
    },
    "smoke": {
      "value": "#7b4fa8",
      "description": "Arena partner: purple smoke behind the games."
    },
    "gold": {
      "value": "#ffd166",
      "description": "Arena partner: climb line."
    },
    "cyan": {
      "value": "#3ad8ff",
      "description": "Arena partner: aura highlight."
    },
    "blue": {
      "value": "#3b5bff",
      "description": "Partner hero glow."
    }
  },
  "color": {
    "bg": {
      "description": "Page canvas behind everything.",
      "dark": "{brand.night}",
      "light": "#fbfafc"
    },
    "surface": {
      "description": "Cards, panels, the trade ticket.",
      "dark": "#171119",
      "light": "#ffffff"
    },
    "raised": {
      "description": "A surface above a surface: menus, hover rows, inset wells.",
      "dark": "#210f26",
      "light": "#f2edf4"
    },
    "border": {
      "description": "Hairlines and dividers.",
      "dark": "#44384b",
      "light": "#ded3e2"
    },
    "border-input": {
      "description": "Outline of inputs and other controls that must meet 3:1 against the surface.",
      "dark": "#9987a3",
      "light": "#927d9c"
    },
    "text": {
      "description": "Primary text.",
      "dark": "{brand.bone}",
      "light": "#0b000f"
    },
    "text-muted": {
      "description": "Secondary text: labels, meta, captions. Still AA on every surface.",
      "dark": "#bfb5c5",
      "light": "#64556c"
    },
    "brand": {
      "description": "Orchid. Brand ink for links, active navigation, the Yes line on charts, focus. Never a large fill.",
      "dark": "{brand.orchid}",
      "light": "{brand.orchid-deep}"
    },
    "brand-soft": {
      "description": "Quiet orchid fill behind brand-coloured content.",
      "dark": "#2f0e35",
      "light": "#f0e5f3"
    },
    "accent": {
      "description": "The single action colour: filled primary buttons. One per view.",
      "dark": "#9f50a4",
      "light": "{brand.orchid-deep}"
    },
    "on-accent": {
      "description": "Text and icons on an accent fill.",
      "dark": "#ffffff",
      "light": "#ffffff"
    },
    "accent-hover": {
      "description": "Accent fill on hover and press.",
      "dark": "#8b4093",
      "light": "#570068"
    },
    "focus": {
      "description": "Keyboard focus ring.",
      "dark": "{brand.orchid}",
      "light": "{brand.orchid-deep}"
    },
    "council": {
      "description": "Council and dispute identity. Currently the same orchid as brand.",
      "dark": "{brand.orchid}",
      "light": "{brand.orchid-deep}"
    },
    "council-soft": {
      "description": "Quiet fill behind Council content.",
      "dark": "#2f0e35",
      "light": "#f0e5f3"
    },
    "on-council": {
      "description": "Text on a council fill.",
      "dark": "#1a0b1e",
      "light": "#ffffff"
    },
    "yes": {
      "description": "The Yes side of a market: prices, outlines, bars.",
      "dark": "#e7c2f7",
      "light": "#5c0f6b"
    },
    "yes-soft": {
      "description": "Fill behind a Yes control or tag.",
      "dark": "#290036",
      "light": "#f0e5f3"
    },
    "no": {
      "description": "The No side of a market. Mint family, the partner of orchid.",
      "dark": "#2fa39a",
      "light": "#14756f"
    },
    "no-soft": {
      "description": "Fill behind a No control or tag.",
      "dark": "#102c2a",
      "light": "#e4f2ef"
    },
    "success": {
      "description": "Status only: open markets, confirmed actions, price up. Not an outcome colour.",
      "dark": "#9ed6b4",
      "light": "#21643e"
    },
    "danger": {
      "description": "Status only: errors, destructive actions, price down.",
      "dark": "#f4a4b0",
      "light": "#a12343"
    },
    "danger-soft": {
      "description": "Fill behind danger content.",
      "dark": "#351923",
      "light": "#fce9ef"
    },
    "warning": {
      "description": "Status only: deadlines, pending risk.",
      "dark": "#e3c47e",
      "light": "#75520a"
    },
    "warning-soft": {
      "description": "Fill behind warning content.",
      "dark": "#302716",
      "light": "#fcf3d9"
    },
    "info": {
      "description": "Neutral informational status.",
      "dark": "#c8bdcf",
      "light": "#64556c"
    },
    "info-soft": {
      "description": "Fill behind info content.",
      "dark": "#210f26",
      "light": "#f2edf4"
    },
    "category-politics-bg": {
      "description": "Category chip background for politics.",
      "dark": "#253b55",
      "light": "#e7eef6"
    },
    "category-politics-ink": {
      "description": "Category chip text and icon for politics.",
      "dark": "#bbd3ed",
      "light": "#294867"
    },
    "category-sports-bg": {
      "description": "Category chip background for sports.",
      "dark": "#483125",
      "light": "#f5ebe3"
    },
    "category-sports-ink": {
      "description": "Category chip text and icon for sports.",
      "dark": "#edc4a1",
      "light": "#80502e"
    },
    "category-crypto-bg": {
      "description": "Category chip background for crypto.",
      "dark": "#44381f",
      "light": "#f3eddf"
    },
    "category-crypto-ink": {
      "description": "Category chip text and icon for crypto.",
      "dark": "#e8cd8e",
      "light": "#765b24"
    },
    "category-economy-bg": {
      "description": "Category chip background for economy.",
      "dark": "#203d35",
      "light": "#e4f0ea"
    },
    "category-economy-ink": {
      "description": "Category chip text and icon for economy.",
      "dark": "#a9dac8",
      "light": "#2d6752"
    },
    "category-tech-bg": {
      "description": "Category chip background for tech.",
      "dark": "#38304f",
      "light": "#ede8f6"
    },
    "category-tech-ink": {
      "description": "Category chip text and icon for tech.",
      "dark": "#d4c2ef",
      "light": "#654486"
    },
    "category-culture-bg": {
      "description": "Category chip background for culture.",
      "dark": "#492f40",
      "light": "#f4e7ef"
    },
    "category-culture-ink": {
      "description": "Category chip text and icon for culture.",
      "dark": "#e5bbd3",
      "light": "#85466e"
    },
    "category-world-bg": {
      "description": "Category chip background for world.",
      "dark": "#243b41",
      "light": "#e6f0f2"
    },
    "category-world-ink": {
      "description": "Category chip text and icon for world.",
      "dark": "#a9d1d9",
      "light": "#356875"
    },
    "category-other-bg": {
      "description": "Category chip background for other.",
      "dark": "#35323c",
      "light": "#eceaef"
    },
    "category-other-ink": {
      "description": "Category chip text and icon for other.",
      "dark": "#c7c3d0",
      "light": "#60566d"
    },
    "crest": {
      "description": "Mint. The dragon crest and nothing else in the product UI.",
      "dark": "{brand.mint}",
      "light": "{brand.mint-deep}"
    }
  },
  "font": {
    "display": {
      "family": "Funnel Display",
      "variable": "--font-funnel",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "fallback": "var(--font-sans-stack)",
      "use": "Market questions, page titles, odds, balances, verdicts."
    },
    "sans": {
      "family": "IBM Plex Sans",
      "variable": "--font-plex",
      "weights": [
        300,
        400,
        500,
        600
      ],
      "fallback": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "use": "Everything else: body, labels, controls, tables."
    },
    "mono": {
      "family": "IBM Plex Mono",
      "variable": "--font-plex-mono",
      "weights": [
        400,
        500
      ],
      "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "use": "Machine identifiers only: rule hashes, account IDs, keyboard keys. Part of the Plex family."
    }
  },
  "typeStyles": {
    "odds-hero": {
      "font": "display",
      "size": "8.5rem",
      "fluid": "clamp(5rem, 3rem + 6vw, 8.5rem)",
      "weight": 500,
      "leading": "0.78",
      "tracking": "-0.04em",
      "use": "The one big chance-of-Yes number on a spotlight or market page. Tabular lining figures."
    },
    "market-title": {
      "font": "display",
      "size": "3.5rem",
      "fluid": "clamp(2rem, 1.3rem + 2.4vw, 3.5rem)",
      "weight": 600,
      "leading": "1.04",
      "tracking": "-0.02em",
      "use": "The market question on its own page."
    },
    "page-title": {
      "font": "display",
      "size": "4xl",
      "weight": 600,
      "leading": "tight",
      "tracking": "-0.025em",
      "use": "Page and section heroes."
    },
    "card-title": {
      "font": "display",
      "size": "1.25rem",
      "weight": 600,
      "leading": "1.18",
      "tracking": "-0.025em",
      "use": "Market card questions, clamped to three lines."
    },
    "price": {
      "font": "display",
      "size": "2xl",
      "weight": 500,
      "leading": "1",
      "tracking": "-0.04em",
      "use": "Prices, balances and percentages in cards and the trade ticket."
    },
    "heading": {
      "font": "sans",
      "size": "xl",
      "weight": 500,
      "leading": "snug",
      "tracking": "title",
      "use": "In-page headings inside panels."
    },
    "body": {
      "font": "sans",
      "size": "md",
      "weight": 400,
      "leading": "body",
      "use": "Paragraphs and descriptions."
    },
    "ui": {
      "font": "sans",
      "size": "sm",
      "weight": 500,
      "leading": "1",
      "use": "Buttons, tabs, navigation, form labels."
    },
    "meta": {
      "font": "sans",
      "size": "xs",
      "weight": 400,
      "leading": "snug",
      "use": "Timestamps, volume, captions. Use text-muted."
    },
    "identifier": {
      "font": "mono",
      "size": "xs",
      "weight": 400,
      "leading": "snug",
      "tracking": "-0.01em",
      "use": "Rule hashes and account IDs only."
    }
  },
  "size": {
    "2xs": "0.75rem",
    "xs": "0.8125rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.375rem",
    "2xl": "1.75rem",
    "3xl": "2.25rem",
    "4xl": "3rem",
    "5xl": "4rem",
    "6xl": "5.5rem"
  },
  "leading": {
    "tight": "1.1",
    "snug": "1.3",
    "body": "1.6"
  },
  "tracking": {
    "display": "-0.035em",
    "title": "-0.02em",
    "eyebrow": "0.08em"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "7": "2rem",
    "8": "2.5rem",
    "9": "3rem",
    "10": "4rem",
    "11": "5rem",
    "12": "6rem"
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "pill": "999px"
  },
  "control": {
    "sm": "36px",
    "md": "44px",
    "lg": "52px"
  },
  "layout": {
    "page-max": "90rem",
    "gutter": "clamp(1rem, 3.2vw, 3rem)",
    "header-h": "4rem",
    "ticket-w": "24rem",
    "section-space": "clamp(3rem, 6vw, 5rem)",
    "content-radius": "var(--r-lg)"
  },
  "duration": {
    "1": "120ms",
    "2": "180ms",
    "3": "220ms",
    "4": "420ms",
    "5": "720ms"
  },
  "easing": {
    "out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "emph": "cubic-bezier(0.22, 1.2, 0.36, 1)"
  },
  "stagger": "28ms",
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.accent}",
      "textColor": "{colors.on-accent}",
      "typography": "{typography.ui}",
      "rounded": "{rounded.sm}",
      "height": "44px",
      "padding": "0 20px"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.accent-hover}",
      "textColor": "{colors.on-accent}"
    },
    "button-secondary": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.ui}",
      "rounded": "{rounded.sm}",
      "height": "44px",
      "padding": "0 20px"
    },
    "outcome-yes": {
      "backgroundColor": "{colors.yes-soft}",
      "textColor": "{colors.yes}",
      "typography": "{typography.price}",
      "rounded": "{rounded.md}"
    },
    "outcome-no": {
      "backgroundColor": "{colors.no-soft}",
      "textColor": "{colors.no}",
      "typography": "{typography.price}",
      "rounded": "{rounded.md}"
    },
    "status-pill": {
      "textColor": "{colors.success}",
      "typography": "{typography.meta}",
      "rounded": "{rounded.pill}",
      "height": "24px",
      "padding": "0 10px"
    },
    "card": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.lg}",
      "padding": "24px"
    },
    "input": {
      "backgroundColor": "{colors.bg}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "rounded": "{rounded.md}",
      "height": "52px"
    }
  }
}